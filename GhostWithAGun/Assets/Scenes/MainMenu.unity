  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "My son booked this room for me. Said he was \u201Clooking forward to his
    inheritance,\u201D whatever that means! Strange kid. Anyway, this was the best
    hotel I\u2019ve stayed at in years. Finally, a place that respects real American
    values. Only downside was one of the other guests kept making noise at night."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 193b73b5fed629e4c85f0e06b5321da5, type: 2}
